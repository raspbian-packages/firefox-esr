From: Mike Hommey <mh+mozilla@glandium.org>
Date: Wed, 28 Oct 2026 22:00:19 +0900
Subject: Bug 2086584 - Fix building for i686 without SSE.
 r=spidermonkey-reviewers,yury

Differential Revision: https://phabricator.services.mozilla.com/D337566
---
 js/src/util/Denormals.h      | 5 ++++-
 js/src/wasm/WasmInstance.cpp | 2 +-
 2 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/js/src/util/Denormals.h b/js/src/util/Denormals.h
index 28a7892..f36eeb2 100644
--- a/js/src/util/Denormals.h
+++ b/js/src/util/Denormals.h
@@ -28,6 +28,9 @@ static constexpr uint32_t MxcsrDenormalsDisabled =
     MxcsrFlushToZero | MxcsrDenormalsAreZero;
 
 #if defined(JS_CODEGEN_X86) || defined(JS_CODEGEN_X64)
+#  if defined(__GNUC__) || defined(__clang__)
+__attribute__((target("sse")))
+#  endif
 inline uint32_t ReadMxcsr() { return _mm_getcsr(); }
 #endif
 
@@ -73,7 +76,7 @@ inline bool CanDisableDenormals() {
 // Returns false on platforms where we cannot read the FP control register.
 inline bool DenormalsDisabled() {
 #if defined(JS_CODEGEN_X86) || defined(JS_CODEGEN_X64)
-  return (ReadMxcsr() & MxcsrDenormalsDisabled) != 0;
+  return mozilla::supports_sse() && ((ReadMxcsr() & MxcsrDenormalsDisabled) != 0);
 #elif defined(__GNUC__) && defined(__aarch64__)
   uint64_t fpcr;
   asm volatile("mrs %0, FPCR" : "=r"(fpcr));
diff --git a/js/src/wasm/WasmInstance.cpp b/js/src/wasm/WasmInstance.cpp
index 9c3ae1f..3785a725 100644
--- a/js/src/wasm/WasmInstance.cpp
+++ b/js/src/wasm/WasmInstance.cpp
@@ -2538,7 +2538,7 @@ bool Instance::init(JSContext* cx, const JSObjectVector& funcImports,
 
   // Capture this thread's MXCSR once, so the wasm stubs can restore it with
   // a single ldmxcsr each.
-  uint32_t mxcsr = ReadMxcsr();
+  uint32_t mxcsr = mozilla::supports_sse() ? ReadMxcsr() : 0;
   ieeeMxcsr_ = mxcsr;
   if (CanDisableDenormals() && cx->options().wasmDisablesDenormals()) {
     wasmMxcsr_ = mxcsr | MxcsrDenormalsDisabled;
